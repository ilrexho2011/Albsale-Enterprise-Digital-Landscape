<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- ProxyEndpoint: hyrja publike, politikat e sigurisë/kufizimit dhe route-t -->
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>Spike-Arrest</Name></Step>
      <Step><Name>Verify-API-Key</Name></Step>
      <Step><Name>Quota-Business</Name></Step>
      <Step><Name>Remove-API-Key-Header</Name></Step>
    </Request>
    <Response>
      <Step><Name>CORS</Name></Step>
    </Response>
  </PreFlow>
  <Flows>
    <Flow name="CreateOrder">
      <Condition>(proxy.pathsuffix MatchesPath "/orders") and (request.verb = "POST")</Condition>
      <Description>Vendos porosi (async -> JMS te CI)</Description>
    </Flow>
    <Flow name="ATPCheck">
      <Condition>(proxy.pathsuffix MatchesPath "/atp") and (request.verb = "POST")</Condition>
      <Description>Kontroll aATP</Description>
    </Flow>
    <Flow name="StockRead">
      <Condition>(proxy.pathsuffix MatchesPath "/stock") and (request.verb = "GET")</Condition>
      <Description>Lexim stoku</Description>
    </Flow>
    <Flow name="FinanceStatus">
      <Condition>(proxy.pathsuffix MatchesPath "/finance") and (request.verb = "GET")</Condition>
      <Description>Gjendja A/R</Description>
    </Flow>
    <Flow name="Options">
      <Condition>request.verb = "OPTIONS"</Condition>
      <Request/><Response><Step><Name>CORS</Name></Step></Response>
    </Flow>
  </Flows>
  <HTTPProxyConnection>
    <BasePath>/albsale/o2c/v1</BasePath>
    <VirtualHost>secure</VirtualHost>
  </HTTPProxyConnection>
  <RouteRule name="default"><TargetEndpoint>default</TargetEndpoint></RouteRule>
</ProxyEndpoint>
