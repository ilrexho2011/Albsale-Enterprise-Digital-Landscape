<?xml version="1.0" encoding="UTF-8"?>
<!--
  IF_Salt_O2C_Event_In.iflw · v2.0.0 · Phase 3
  INBOUND: S/4HANA (ORDRSP / DELVRY03 / INVOIC02) -> CI -> Custom ERP receive_event.php.
  Router sipas EDI_DC40/MESTYP -> mapping i dedikuar (i plotë) -> event kanonik v2.
  Sender: IDoc /salt/events   Receiver: HTTP -> receive_event.php (X-Inbound-Token)
-->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ifl="http:///com.sap.ifl.model/Ifl.xsd"
                   id="Definitions_Event_In_v2">

  <bpmn2:collaboration id="Collab_EventIn" name="IF_Salt_O2C_Event_In">
    <bpmn2:extensionElements>
      <ifl:property><key>namespaceMapping</key><value>o2c=urn:albsale:o2c:canonical:1.0</value></ifl:property>
      <ifl:property><key>log</key><value>All events</value></ifl:property>
    </bpmn2:extensionElements>

    <bpmn2:participant id="P_Sender"   ifl:type="EndpointSender"   name="S4HANA"/>
    <bpmn2:participant id="P_Receiver" ifl:type="EndpointReceiver" name="ERP_Salt"/>
    <bpmn2:participant id="P_Proc"     ifl:type="IntegrationProcess" name="Integration Process" processRef="Proc_EventIn"/>

    <bpmn2:messageFlow id="MF_Sender_IDoc" name="IDoc" sourceRef="P_Sender" targetRef="Start_Evt">
      <bpmn2:extensionElements>
        <ifl:property><key>ComponentType</key><value>IDOC</value></ifl:property>
        <ifl:property><key>TransportProtocol</key><value>HTTP</value></ifl:property>
        <ifl:property><key>urlPath</key><value>/salt/events</value></ifl:property>
        <ifl:property><key>senderAuthType</key><value>ClientCertificate</value></ifl:property>
        <ifl:property><key>direction</key><value>Sender</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:messageFlow>

    <bpmn2:messageFlow id="MF_Receiver_HTTP" name="HTTP" sourceRef="End_Evt" targetRef="P_Receiver">
      <bpmn2:extensionElements>
        <ifl:property><key>ComponentType</key><value>HTTP</value></ifl:property>
        <ifl:property><key>httpAddressWithoutQuery</key><value>{{erp_receive_event_url}}</value></ifl:property>
        <ifl:property><key>httpMethod</key><value>POST</value></ifl:property>
        <ifl:property><key>direction</key><value>Receiver</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:messageFlow>
  </bpmn2:collaboration>

  <bpmn2:process id="Proc_EventIn" name="Integration Process">
    <bpmn2:startEvent id="Start_Evt" name="Start">
      <bpmn2:messageEventDefinition/>
      <bpmn2:outgoing>r0</bpmn2:outgoing>
    </bpmn2:startEvent>

    <!-- ROUTER sipas MESTYP -->
    <bpmn2:exclusiveGateway id="GW_Route" name="Route by MESTYP" ifl:activityType="ExclusiveGateway">
      <bpmn2:incoming>r0</bpmn2:incoming>
      <bpmn2:outgoing>r_ordrsp</bpmn2:outgoing>
      <bpmn2:outgoing>r_desadv</bpmn2:outgoing>
      <bpmn2:outgoing>r_invoic</bpmn2:outgoing>
      <bpmn2:outgoing>r_default</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:callActivity id="MM_ORDRSP" name="Map ORDRSP" ifl:activityType="XSLTMapping">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>XSLTMapping</value></ifl:property>
        <ifl:property><key>mappingPath</key><value>mapping/ORDRSP_to_Canonical.xsl</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>r_ordrsp</bpmn2:incoming><bpmn2:outgoing>m1</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="MM_DESADV" name="Map DELVRY03" ifl:activityType="XSLTMapping">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>XSLTMapping</value></ifl:property>
        <ifl:property><key>mappingPath</key><value>mapping/DELVRY03_to_Canonical.xsl</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>r_desadv</bpmn2:incoming><bpmn2:outgoing>m2</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="MM_INVOIC" name="Map INVOIC02" ifl:activityType="XSLTMapping">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>XSLTMapping</value></ifl:property>
        <ifl:property><key>mappingPath</key><value>mapping/INVOIC02_to_Canonical.xsl</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>r_invoic</bpmn2:incoming><bpmn2:outgoing>m3</bpmn2:outgoing>
    </bpmn2:callActivity>

    <!-- Konvergjenca -->
    <bpmn2:exclusiveGateway id="GW_Join" name="Join">
      <bpmn2:incoming>m1</bpmn2:incoming><bpmn2:incoming>m2</bpmn2:incoming>
      <bpmn2:incoming>m3</bpmn2:incoming><bpmn2:incoming>r_default</bpmn2:incoming>
      <bpmn2:outgoing>j1</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:callActivity id="CM_Token" name="Load Inbound Token" ifl:activityType="Enricher">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>Enricher</value></ifl:property>
        <ifl:property><key>propertyTable</key><value>&lt;row&gt;&lt;name&gt;erp_inbound_token&lt;/name&gt;&lt;value&gt;{{erp_inbound_token}}&lt;/value&gt;&lt;type&gt;constant&lt;/type&gt;&lt;/row&gt;</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>j1</bpmn2:incoming><bpmn2:outgoing>j2</bpmn2:outgoing>
    </bpmn2:callActivity>

    <bpmn2:callActivity id="SC_Ctx" name="Set Inbound Context" ifl:activityType="Script">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>Script</value></ifl:property>
        <ifl:property><key>scriptFunction</key><value>processData</value></ifl:property>
        <ifl:property><key>script</key><value>setInboundContext.groovy</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>j2</bpmn2:incoming><bpmn2:outgoing>j3</bpmn2:outgoing>
    </bpmn2:callActivity>

    <bpmn2:endEvent id="End_Evt" name="End">
      <bpmn2:messageEventDefinition/>
      <bpmn2:incoming>j3</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="r0" sourceRef="Start_Evt" targetRef="GW_Route"/>
    <bpmn2:sequenceFlow id="r_ordrsp" sourceRef="GW_Route" targetRef="MM_ORDRSP">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${xpath.//EDI_DC40/MESTYP = 'ORDRSP'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="r_desadv" sourceRef="GW_Route" targetRef="MM_DESADV">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${xpath.//EDI_DC40/MESTYP = 'DESADV'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="r_invoic" sourceRef="GW_Route" targetRef="MM_INVOIC">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${xpath.//EDI_DC40/MESTYP = 'INVOIC'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="r_default" sourceRef="GW_Route" targetRef="GW_Join" ifl:type="DefaultFlow"/>

    <bpmn2:sequenceFlow id="m1" sourceRef="MM_ORDRSP" targetRef="GW_Join"/>
    <bpmn2:sequenceFlow id="m2" sourceRef="MM_DESADV" targetRef="GW_Join"/>
    <bpmn2:sequenceFlow id="m3" sourceRef="MM_INVOIC" targetRef="GW_Join"/>
    <bpmn2:sequenceFlow id="j1" sourceRef="GW_Join"  targetRef="CM_Token"/>
    <bpmn2:sequenceFlow id="j2" sourceRef="CM_Token" targetRef="SC_Ctx"/>
    <bpmn2:sequenceFlow id="j3" sourceRef="SC_Ctx"   targetRef="End_Evt"/>
  </bpmn2:process>
</bpmn2:definitions>
