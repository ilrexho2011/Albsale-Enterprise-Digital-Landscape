<?xml version="1.0" encoding="UTF-8"?>
<!--
  IF_Salt_Finance_Status.iflw · Phase 4 (Finance A/R status)
  ERP pyet gjendjen financiare të një klienti (open items A/R). CI kthen kërkesë OData drejt
  S/4 (Accounting Document Items) dhe harton përgjigjen në JSON kanonik të gjendjes A/R.
  Sender: HTTPS GET /salt/finance   Receiver: OData S/4 (Request-Reply)
-->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ifl="http:///com.sap.ifl.model/Ifl.xsd" id="Definitions_Fin_Status">

  <bpmn2:collaboration id="Collab_Fin" name="IF_Salt_Finance_Status">
    <bpmn2:extensionElements><ifl:property><key>log</key><value>All events</value></ifl:property></bpmn2:extensionElements>
    <bpmn2:participant id="P_Sender" ifl:type="EndpointSender"   name="ERP_Salt"/>
    <bpmn2:participant id="P_OData"  ifl:type="EndpointReceiver" name="S4HANA_OData_FI"/>
    <bpmn2:participant id="P_Proc"   ifl:type="IntegrationProcess" name="Integration Process" processRef="Proc_Fin"/>

    <bpmn2:messageFlow id="MF_HTTPS" name="HTTPS" sourceRef="P_Sender" targetRef="Start_S">
      <bpmn2:extensionElements>
        <ifl:property><key>ComponentType</key><value>HTTPS</value></ifl:property>
        <ifl:property><key>urlPath</key><value>/salt/finance</value></ifl:property>
        <ifl:property><key>senderAuthType</key><value>ClientCertificate</value></ifl:property>
        <ifl:property><key>Method</key><value>GET</value></ifl:property>
        <ifl:property><key>direction</key><value>Sender</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:messageFlow>
    <bpmn2:messageFlow id="MF_OData" name="OData" sourceRef="RR_OData" targetRef="P_OData">
      <bpmn2:extensionElements>
        <ifl:property><key>ComponentType</key><value>HCIOData</value></ifl:property>
        <ifl:property><key>address</key><value>{{s4_odata_ar_url}}</value></ifl:property>
        <ifl:property><key>credentialName</key><value>{{s4_odata_credential}}</value></ifl:property>
        <ifl:property><key>operation</key><value>Query(GET)</value></ifl:property>
        <ifl:property><key>resourcePath</key><value>A_OperationalAcctgDocItem</value></ifl:property>
        <ifl:property><key>queryOptions</key><value>$filter=Customer eq '${property.p_customer}' and AccountingDocumentType eq 'RV' and IsCleared eq false&amp;$select=AccountingDocument,BillingDocument,AmountInCompanyCodeCurrency,CompanyCodeCurrency,NetDueDate,IsCleared</value></ifl:property>
        <ifl:property><key>direction</key><value>Receiver</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:messageFlow>
  </bpmn2:collaboration>

  <bpmn2:process id="Proc_Fin" name="Integration Process">
    <bpmn2:startEvent id="Start_S" name="Start"><bpmn2:messageEventDefinition/><bpmn2:outgoing>s1</bpmn2:outgoing></bpmn2:startEvent>
    <bpmn2:callActivity id="SC_Req" name="Read Customer Param" ifl:activityType="Script">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>Script</value></ifl:property>
        <ifl:property><key>scriptFunction</key><value>processData</value></ifl:property>
        <ifl:property><key>script</key><value>readFinanceRequest.groovy</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>s1</bpmn2:incoming><bpmn2:outgoing>s2</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="RR_OData" name="Query A/R (OData)" ifl:activityType="ExternalCall">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>ExternalCall</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>s2</bpmn2:incoming><bpmn2:outgoing>s3</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="SC_Map" name="Map A/R to JSON" ifl:activityType="Script">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>Script</value></ifl:property>
        <ifl:property><key>scriptFunction</key><value>processData</value></ifl:property>
        <ifl:property><key>script</key><value>mapFinanceResponse.groovy</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>s3</bpmn2:incoming><bpmn2:outgoing>s4</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:endEvent id="End_S" name="End"><bpmn2:messageEventDefinition/><bpmn2:incoming>s4</bpmn2:incoming></bpmn2:endEvent>
    <bpmn2:sequenceFlow id="s1" sourceRef="Start_S"  targetRef="SC_Req"/>
    <bpmn2:sequenceFlow id="s2" sourceRef="SC_Req"   targetRef="RR_OData"/>
    <bpmn2:sequenceFlow id="s3" sourceRef="RR_OData" targetRef="SC_Map"/>
    <bpmn2:sequenceFlow id="s4" sourceRef="SC_Map"   targetRef="End_S"/>
  </bpmn2:process>
</bpmn2:definitions>
