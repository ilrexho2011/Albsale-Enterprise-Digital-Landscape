<?xml version="1.0" encoding="UTF-8"?>
<!-- IF_Salt_GR_In.iflw · Phase 6 · S/4 IDoc -> XSLT -> ERP erp_gr_url -->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ifl="http:///com.sap.ifl.model/Ifl.xsd" id="Definitions_IF_Salt_GR_In">
  <bpmn2:collaboration id="Collab_IF_Salt_GR_In" name="IF_Salt_GR_In">
    <bpmn2:extensionElements>
      <ifl:property><key>namespaceMapping</key><value>o2c=urn:albsale:o2c:canonical:1.0</value></ifl:property>
      <ifl:property><key>log</key><value>All events</value></ifl:property>
    </bpmn2:extensionElements>
    <bpmn2:participant id="P_Sender"   ifl:type="EndpointSender"   name="S4HANA"/>
    <bpmn2:participant id="P_Receiver" ifl:type="EndpointReceiver" name="ERP_Salt"/>
    <bpmn2:participant id="P_Proc"     ifl:type="IntegrationProcess" name="Integration Process" processRef="Proc_IF_Salt_GR_In"/>
    <bpmn2:messageFlow id="MF_In" name="IDoc" sourceRef="P_Sender" targetRef="St">
      <bpmn2:extensionElements>
        <ifl:property><key>ComponentType</key><value>IDOC</value></ifl:property>
        <ifl:property><key>urlPath</key><value>/salt/gr</value></ifl:property>
        <ifl:property><key>senderAuthType</key><value>ClientCertificate</value></ifl:property>
        <ifl:property><key>direction</key><value>Sender</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:messageFlow>
    <bpmn2:messageFlow id="MF_Out" name="HTTP" sourceRef="En" targetRef="P_Receiver">
      <bpmn2:extensionElements>
        <ifl:property><key>ComponentType</key><value>HTTP</value></ifl:property>
        <ifl:property><key>httpAddressWithoutQuery</key><value>{{erp_gr_url}}</value></ifl:property>
        <ifl:property><key>httpMethod</key><value>POST</value></ifl:property>
        <ifl:property><key>direction</key><value>Receiver</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:messageFlow>
  </bpmn2:collaboration>
  <bpmn2:process id="Proc_IF_Salt_GR_In" name="Integration Process">
    <bpmn2:startEvent id="St" name="Start"><bpmn2:messageEventDefinition/><bpmn2:outgoing>x1</bpmn2:outgoing></bpmn2:startEvent>
    <bpmn2:callActivity id="MM" name="gr mapping" ifl:activityType="XSLTMapping">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>XSLTMapping</value></ifl:property>
        <ifl:property><key>mappingPath</key><value>mapping/MBGMCR_to_GR.xsl</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>x1</bpmn2:incoming><bpmn2:outgoing>x2</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CMt" name="Load Token" ifl:activityType="Enricher">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>Enricher</value></ifl:property>
        <ifl:property><key>propertyTable</key><value>&lt;row&gt;&lt;name&gt;erp_inbound_token&lt;/name&gt;&lt;value&gt;{{erp_inbound_token}}&lt;/value&gt;&lt;type&gt;constant&lt;/type&gt;&lt;/row&gt;</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>x2</bpmn2:incoming><bpmn2:outgoing>x3</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="SCc" name="Set Inbound Context" ifl:activityType="Script">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>Script</value></ifl:property>
        <ifl:property><key>scriptFunction</key><value>processData</value></ifl:property>
        <ifl:property><key>script</key><value>setInboundContext.groovy</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:incoming>x3</bpmn2:incoming><bpmn2:outgoing>x4</bpmn2:outgoing>
    </bpmn2:callActivity>
    <bpmn2:endEvent id="En" name="End"><bpmn2:messageEventDefinition/><bpmn2:incoming>x4</bpmn2:incoming></bpmn2:endEvent>
    <bpmn2:sequenceFlow id="x1" sourceRef="St"  targetRef="MM"/>
    <bpmn2:sequenceFlow id="x2" sourceRef="MM"  targetRef="CMt"/>
    <bpmn2:sequenceFlow id="x3" sourceRef="CMt" targetRef="SCc"/>
    <bpmn2:sequenceFlow id="x4" sourceRef="SCc" targetRef="En"/>
  </bpmn2:process>
</bpmn2:definitions>
